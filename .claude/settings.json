{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks-claude-code",
            "args": [
              "hook",
              "--project-root",
              "/Users/funes/Documents/personal/polydeukes",
              "--pdks",
              "/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
