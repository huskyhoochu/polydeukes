{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks",
            "args": [
              "adapter",
              "claude-code",
              "hook",
              "--project-root",
              "/Users/funes/Documents/personal/polydeukes"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks",
            "args": [
              "adapter",
              "claude-code",
              "hook",
              "--project-root",
              "/Users/funes/Documents/personal/polydeukes"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks",
            "args": [
              "adapter",
              "claude-code",
              "hook",
              "--project-root",
              "/Users/funes/Documents/personal/polydeukes"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks",
            "args": [
              "adapter",
              "claude-code",
              "hook",
              "--project-root",
              "/Users/funes/Documents/personal/polydeukes"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
