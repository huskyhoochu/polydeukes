{
  "description": "A new file under a link to a protected directory is blocked by its real name.",
  "tree": {
    ".polydeukes/baseline.json": {
      "entries": {}
    },
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    },
    "gate/keep": ""
  },
  "links": {
    "shortcut": "gate"
  },
  "stdin": {
    "session_id": "s-1",
    "turn_id": "t-1",
    "transcript_path": null,
    "cwd": "@@ROOT@@",
    "hook_event_name": "PreToolUse",
    "model": "gpt-5",
    "permission_mode": "default",
    "tool_name": "apply_patch",
    "tool_use_id": "call-1",
    "tool_input": {
      "command": "*** Begin Patch\n*** Add File: shortcut/new.txt\n+x\n*** End Patch"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["protected path gate/new.txt"],
    "rows": [["passed", "covenant-check", "-"], ["blocked", "self-mod", "gate"]]
  }
}
