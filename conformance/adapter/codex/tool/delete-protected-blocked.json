{
  "description": "An apply_patch Delete File of an existing protected file is blocked.",
  "tree": {
    ".polydeukes/baseline.json": {
      "entries": {}
    },
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    },
    "gate/inner.txt": "old\n"
  },
  "stdin": {
    "session_id": "s-1",
    "turn_id": "t-1",
    "transcript_path": null,
    "cwd": "@@ROOT@@",
    "hook_event_name": "PreToolUse",
    "model": "gpt-5",
    "permission_mode": "default",
    "tool_name": "apply_patch",
    "tool_use_id": "call-1",
    "tool_input": {
      "command": "*** Begin Patch\n*** Delete File: gate/inner.txt\n*** End Patch"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["apply_patch would modify protected path gate/inner.txt"],
    "rows": [["blocked", "self-mod", "gate"]]
  }
}
