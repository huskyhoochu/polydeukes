{
  "description": "An Add File over an existing file carries that file as its pre-state.",
  "tree": {
    ".polydeukes/baseline.json": {
      "entries": {}
    },
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "see",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"]
            },
            "extract": {
              "pre": [
                {
                  "op": "source",
                  "of": "pre"
                }
              ],
              "post": [
                {
                  "op": "source",
                  "of": "post"
                }
              ]
            },
            "relate": [
              {
                "id": "pre-seen",
                "relation": {
                  "op": "empty",
                  "of": "pre"
                },
                "message": "pre"
              },
              {
                "id": "post-seen",
                "relation": {
                  "op": "empty",
                  "of": "post"
                },
                "message": "post"
              }
            ]
          }
        }
      ]
    },
    "lib/a.txt": "old\n"
  },
  "stdin": {
    "session_id": "s-1",
    "turn_id": "t-1",
    "transcript_path": null,
    "cwd": "@@ROOT@@",
    "hook_event_name": "PreToolUse",
    "model": "gpt-5",
    "permission_mode": "default",
    "tool_name": "apply_patch",
    "tool_use_id": "call-1",
    "tool_input": {
      "command": "*** Begin Patch\n*** Add File: lib/a.txt\n+new\n*** End Patch"
    }
  },
  "expect": {
    "exit": 0,
    "stderr": ["discipline 'see' broken on lib/a.txt"],
    "rows": [
      [
        "advised",
        "see",
        "lib/a.txt",
        "[{\"id\":\"pre-seen\",\"witnesses\":[{\"key\":\"0\",\"value\":\"old\\n\"}],\"total\":1},{\"id\":\"post-seen\",\"witnesses\":[{\"key\":\"0\",\"value\":\"new\\n\"}],\"total\":1}]"
      ]
    ]
  }
}
