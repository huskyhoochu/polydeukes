{
  "description": "GROK_WORKSPACE_ROOT set to the empty string counts as absent, so the payload is judged and a protected Write is blocked.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    }
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s-1",
    "cwd": "@@ROOT@@",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "@@ROOT@@/gate/inner.txt",
      "content": "x\n"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["Write would modify protected path gate/inner.txt"],
    "rows": [["blocked", "self-mod", "gate"]]
  },
  "env": {
    "GROK_WORKSPACE_ROOT": ""
  }
}
