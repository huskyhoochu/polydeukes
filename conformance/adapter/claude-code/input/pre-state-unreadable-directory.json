{
  "description": "A Write whose target is a directory cannot be read as a pre-state and fails closed.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    },
    "lib/dir/keep": ""
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s-1",
    "cwd": "@@ROOT@@",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "@@ROOT@@/lib/dir",
      "content": "x\n"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["covenant check failed closed"],
    "rows": [["blocked", "covenant-check", "-"]]
  }
}
