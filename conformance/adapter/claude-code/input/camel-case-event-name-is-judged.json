{
  "description": "The event name may be spelled hookEventName, and the payload is then judged normally.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    }
  },
  "stdin": {
    "hookEventName": "PreToolUse",
    "cwd": "@@ROOT@@",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "@@ROOT@@/gate/inner.txt",
      "content": "x\n"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["Write would modify protected path gate/inner.txt"],
    "rows": [["blocked", "self-mod", "gate"]]
  }
}
