{
  "description": "A line that is not JSON in the transcript is skipped and the human token after it still opens the valve.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"],
      "witness": {
        "token": "agreed-token",
        "ttlMinutes": 10
      }
    },
    ".polydeukes/baseline.json": {
      "entries": {}
    },
    "sessions/s-1.jsonl": "not json at all\n[1]\n{\"origin\":{\"kind\":\"human\"},\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":\"agreed-token\\nplease proceed\"},\"timestamp\":\"@@NOW_ISO-60000@@\",\"uuid\":\"u1\"}\n"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s-1",
    "cwd": "@@ROOT@@",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "@@ROOT@@/gate/inner.txt",
      "content": "x\n"
    },
    "transcript_path": "@@ROOT@@/sessions/s-1.jsonl"
  },
  "expect": {
    "exit": 0,
    "stderr": ["Write would modify protected path gate/inner.txt"],
    "rows": [["witnessed", "self-mod", "gate"]]
  }
}
