{
  "description": "A NotebookEdit is judged on its notebook_path, so a protected notebook is blocked.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    },
    "gate/n.ipynb": {
      "cells": [
        {
          "id": "c1",
          "cell_type": "code",
          "source": "a = 1\n"
        }
      ]
    }
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s-1",
    "cwd": "@@ROOT@@",
    "tool_name": "NotebookEdit",
    "tool_input": {
      "notebook_path": "@@ROOT@@/gate/n.ipynb",
      "cell_id": "c1",
      "new_source": "a = 2\n"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["NotebookEdit would modify protected path gate/n.ipynb"],
    "rows": [["blocked", "self-mod", "gate"]]
  }
}
