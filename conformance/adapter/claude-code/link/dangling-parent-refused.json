{
  "description": "A Write of a new file under a dangling directory link is refused.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    }
  },
  "links": {
    "lib/deadir": "nowhere"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s-1",
    "cwd": "@@ROOT@@",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "@@ROOT@@/lib/deadir/new.txt",
      "content": "y\n"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["covenant check failed closed", "dangling symbolic link"],
    "rows": [["blocked", "covenant-check", "-"]]
  }
}
