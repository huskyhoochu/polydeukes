{
  "description": "A Write through a link whose real target is protected is blocked under the real name.",
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"]
    },
    "gate/inner.txt": "x\n"
  },
  "links": {
    "alias.txt": "gate/inner.txt"
  },
  "stdin": {
    "hook_event_name": "PreToolUse",
    "session_id": "s-1",
    "cwd": "@@ROOT@@",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "@@ROOT@@/alias.txt",
      "content": "y\n"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["Write would modify protected path gate/inner.txt"],
    "rows": [["passed", "covenant-check", "@@ROOT@@/alias.txt"], ["blocked", "self-mod", "gate"]]
  }
}
