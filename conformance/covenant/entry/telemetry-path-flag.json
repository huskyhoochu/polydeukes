{
  "description": "The telemetry path flag wins over the environment variable and the config log path.",
  "args": ["--telemetry-path", "@@ROOT@@/flag-out/flag.log"],
  "env": {
    "POLYDEUKES_TELEMETRY_PATH": "@@ROOT@@/env.log"
  },
  "tree": {
    "polydeukes.config.yaml": {
      "telemetry": {
        "logPath": "config.log"
      }
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Mystery",
        "args": {
          "file_path": "notes.txt"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "log": "flag-out/flag.log",
    "rows": [["passed", "covenant-check", "notes.txt"]]
  }
}
