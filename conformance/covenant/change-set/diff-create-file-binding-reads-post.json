{
  "description": "A file binding on a path the diff creates reads the diff plus lines, not the working tree.",
  "args": ["--diff"],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "reads-tree",
          "declare": {
            "mechanism": "controlled-vocabulary",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"]
            },
            "sources": {
              "whole": {
                "file": "lib/a.txt"
              }
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "whole"
                },
                {
                  "op": "matches",
                  "re": "."
                }
              ],
              "none": [
                {
                  "op": "source",
                  "of": "target.path"
                },
                {
                  "op": "matches",
                  "re": "^never$"
                }
              ]
            },
            "relate": [
              {
                "id": "seen",
                "relation": {
                  "op": "subset",
                  "of": "hit",
                  "in": "none"
                },
                "message": "{value}"
              }
            ]
          }
        }
      ]
    },
    "lib/a.txt": "clean\n"
  },
  "stdin": "diff --git a/lib/a.txt b/lib/a.txt\nnew file mode 100644\nindex 0000000..e69de29\n--- /dev/null\n+++ b/lib/a.txt\n@@ -0,0 +1 @@\n+TODO from diff\n",
  "expect": {
    "exit": 0,
    "stderr": [
      "TODO from diff",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      [
        "advised",
        "reads-tree",
        "lib/a.txt",
        "[{\"id\":\"seen\",\"witnesses\":[{\"key\":\"0\",\"value\":\"TODO from diff\"}],\"total\":1}]"
      ]
    ]
  }
}
