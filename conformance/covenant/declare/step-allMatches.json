{
  "description": "The allMatches step yields one item per non-overlapping match, keyed by capture group 1.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "step-allMatches",
          "declare": {
            "mechanism": "added-only",
            "extract": {
              "out": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "allMatches",
                  "re": "#(\\d+)"
                }
              ]
            },
            "relate": [
              {
                "id": "found",
                "relation": {
                  "op": "empty",
                  "of": "out"
                },
                "message": "found '{key}'"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/held.txt",
          "post": "no refs\n"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/broken.txt",
          "post": "fix #12 and #7\n"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-allMatches' broken on src/broken.txt: found '12' (+1)",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-allMatches", "src/held.txt"],
      [
        "advised",
        "step-allMatches",
        "src/broken.txt",
        "[{\"id\":\"found\",\"witnesses\":[{\"key\":\"12\",\"value\":\"#12\"},{\"key\":\"7\",\"value\":\"#7\"}],\"total\":2}]"
      ]
    ]
  }
}
