{
  "description": "The keyBy step re-keys each element by a field and drops an element that lacks it.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "step-keyBy",
          "declare": {
            "mechanism": "added-only",
            "extract": {
              "out": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "json"
                },
                {
                  "op": "items"
                },
                {
                  "op": "keyBy",
                  "field": "id"
                }
              ]
            },
            "relate": [
              {
                "id": "found",
                "relation": {
                  "op": "empty",
                  "of": "out"
                },
                "message": "found '{key}'"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/held.txt",
          "post": "[{\"name\":\"n\"}]"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/broken.txt",
          "post": "[{\"name\":\"n\"},{\"id\":\"k1\"}]"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-keyBy' broken on src/broken.txt: found 'k1'",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-keyBy", "src/held.txt"],
      [
        "advised",
        "step-keyBy",
        "src/broken.txt",
        "[{\"id\":\"found\",\"witnesses\":[{\"key\":\"k1\",\"value\":{\"id\":\"k1\"}}],\"total\":1}]"
      ]
    ]
  }
}
