{
  "description": "An entry at block under a block run makes its break a blocked verdict with exit 2.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "no-todo",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"]
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "matches",
                  "re": "TODO"
                }
              ]
            },
            "relate": [
              {
                "id": "no-todo-added",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "adds a TODO marker"
              }
            ]
          },
          "enforce": "block"
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "edit-tool",
        "args": {
          "file_path": "lib/a.txt"
        },
        "fileChange": {
          "kind": "create",
          "path": "lib/a.txt",
          "post": "// TODO"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 2,
    "stderr": ["discipline 'no-todo' broken on lib/a.txt: adds a TODO marker"],
    "rows": [
      [
        "blocked",
        "no-todo",
        "lib/a.txt",
        "[{\"id\":\"no-todo-added\",\"witnesses\":[{\"key\":\"0\",\"value\":\"// TODO\"}],\"total\":1}]"
      ]
    ]
  }
}
