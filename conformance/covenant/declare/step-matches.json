{
  "description": "The matches step keeps the items matching the expression and honours the case-insensitive flag.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "step-matches",
          "declare": {
            "mechanism": "added-only",
            "extract": {
              "out": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "lines"
                },
                {
                  "op": "matches",
                  "re": "^todo",
                  "i": true
                }
              ]
            },
            "relate": [
              {
                "id": "found",
                "relation": {
                  "op": "empty",
                  "of": "out"
                },
                "message": "found '{key}'"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/held.txt",
          "post": "done\nfine\n"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/broken.txt",
          "post": "ok\nTODO x\n"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-matches' broken on src/broken.txt: found '2'",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-matches", "src/held.txt"],
      [
        "advised",
        "step-matches",
        "src/broken.txt",
        "[{\"id\":\"found\",\"witnesses\":[{\"key\":\"2\",\"value\":\"TODO x\"}],\"total\":1}]"
      ]
    ]
  }
}
