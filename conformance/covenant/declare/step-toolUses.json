{
  "description": "The toolUses step narrows a session's tool calls by name and subagent type together, so a call matching only one of them is not counted.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "sessionDisciplines": [
        {
          "id": "step-toolUses",
          "declare": {
            "mechanism": "stated-ground",
            "sources": {
              "session": {
                "transcript": true
              }
            },
            "scope": {
              "source": "target.path",
              "include": ["^held/"]
            },
            "extract": {
              "found": [
                {
                  "op": "source",
                  "of": "session"
                },
                {
                  "op": "toolUses",
                  "names": ["Agent", "Task"],
                  "subagentType": "writer"
                }
              ]
            },
            "relate": [
              {
                "id": "has-evidence",
                "relation": {
                  "op": "nonEmpty",
                  "of": "found"
                },
                "message": "no matching evidence on record"
              }
            ]
          }
        },
        {
          "id": "step-toolUses-miss",
          "declare": {
            "mechanism": "stated-ground",
            "sources": {
              "session": {
                "transcript": true
              }
            },
            "scope": {
              "source": "target.path",
              "include": ["^broken/"]
            },
            "extract": {
              "found": [
                {
                  "op": "source",
                  "of": "session"
                },
                {
                  "op": "toolUses",
                  "names": ["Agent"],
                  "subagentType": "reviewer"
                }
              ]
            },
            "relate": [
              {
                "id": "has-evidence",
                "relation": {
                  "op": "nonEmpty",
                  "of": "found"
                },
                "message": "no matching evidence on record"
              }
            ]
          }
        }
      ]
    },
    ".polydeukes/baseline.json": {
      "entries": {}
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "held/x.txt",
          "post": "x"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "broken/y.txt",
          "post": "y"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "session": {
      "userMessages": [],
      "toolCalls": [
        {
          "name": "Read",
          "args": {
            "file_path": "x"
          }
        },
        {
          "name": "Agent",
          "args": {
            "subagent_type": "writer"
          }
        },
        {
          "name": "Task",
          "args": {
            "subagent_type": "reviewer"
          }
        }
      ]
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-toolUses-miss' broken on broken/y.txt: no matching evidence on record",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-toolUses", "held/x.txt"],
      [
        "advised",
        "step-toolUses-miss",
        "broken/y.txt",
        "[{\"id\":\"has-evidence\",\"witnesses\":[{\"key\":\"found\",\"value\":null}],\"total\":1}]"
      ]
    ]
  }
}
