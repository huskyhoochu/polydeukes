    "tools": {
      "mutating": ["Edit"],
      "shell": ["Bash"],
      "commandArgs": ["command"]
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "rows": [["skipped", "changes-listed-twice", "lib/a.txt", "no-observation"]]
  }
