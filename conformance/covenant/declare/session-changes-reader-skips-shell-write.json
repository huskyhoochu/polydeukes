{
  "description": "A scope-less changes reader and a shell call that writes lib/a.txt leave exactly one row for the entry: skipped naming the written path.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "changes-listed-twice",
          "declare": {
            "mechanism": "controlled-vocabulary",
            "extract": {
              "seen": [
                {
                  "op": "source",
                  "of": "changes"
                },
                {
                  "op": "items"
                }
              ],
              "all": [
                {
                  "op": "source",
                  "of": "changes"
                },
                {
                  "op": "items"
                }
              ]
