{
  "description": "The keyByPattern step keys an item by capture group 1 and drops an item the pattern does not match.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "step-keyByPattern",
          "declare": {
            "mechanism": "added-only",
            "extract": {
              "out": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "lines"
                },
                {
                  "op": "keyByPattern",
                  "re": "^id=(\\w+)"
                }
              ]
            },
            "relate": [
              {
                "id": "found",
                "relation": {
                  "op": "empty",
                  "of": "out"
                },
                "message": "found '{key}'"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/held.txt",
          "post": "name=x\n"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/broken.txt",
          "post": "name=x\nid=abc\n"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-keyByPattern' broken on src/broken.txt: found 'abc'",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-keyByPattern", "src/held.txt"],
      [
        "advised",
        "step-keyByPattern",
        "src/broken.txt",
        "[{\"id\":\"found\",\"witnesses\":[{\"key\":\"abc\",\"value\":\"id=abc\"}],\"total\":1}]"
      ]
    ]
  }
}
