{
  "description": "A shell call that changes no file gets no call-level world for a discipline that reads post, so the call is not blocked as unjudgeable.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "no-todo",
          "declare": {
            "mechanism": "added-only",
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "matches",
                  "re": "TODO"
                }
              ]
            },
            "relate": [
              {
                "id": "clean",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "adds a TODO marker"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "shell-tool",
        "args": {
          "command": "ls"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": ["edit-tool"],
      "shell": ["shell-tool"],
      "commandArgs": ["command"]
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "rows": [["passed", "covenant-check", "-"]]
  }
}
