{
  "description": "The command source is the command text as written, so a heredoc body that a receiving shell would run is read.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"],
      "sessionDisciplines": [
        {
          "id": "no-frob",
          "declare": {
            "mechanism": "forbidden-command",
            "scope": {
              "source": "command"
            },
            "extract": {
              "hits": [
                {
                  "op": "source",
                  "of": "command"
                },
                {
                  "op": "lines"
                },
                {
                  "op": "matches",
                  "re": "frobnicate"
                }
              ]
            },
            "relate": [
              {
                "id": "clean",
                "relation": {
                  "op": "empty",
                  "of": "hits"
                },
                "message": "forbidden: {value}"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "shell-tool",
        "args": {
          "command": "bash <<'EOF'\nfrobnicate --now\nEOF"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": ["edit-tool"],
      "shell": ["shell-tool"],
      "commandArgs": ["command"]
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'no-frob' broken on -: forbidden: frobnicate --now",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      [
        "advised",
        "no-frob",
        "-",
        "[{\"id\":\"clean\",\"witnesses\":[{\"key\":\"2\",\"value\":\"frobnicate --now\"}],\"total\":1}]"
      ],
      ["skipped", "shell-unjudgeable", "-", "no-observation"]
    ]
  }
}
