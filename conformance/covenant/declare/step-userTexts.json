{
  "description": "The userTexts step keeps user turns matching the expression and honours the case-insensitive flag.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "sessionDisciplines": [
        {
          "id": "step-userTexts",
          "declare": {
            "mechanism": "stated-ground",
            "sources": {
              "session": {
                "transcript": true
              }
            },
            "scope": {
              "source": "target.path",
              "include": ["^held/"]
            },
            "extract": {
              "found": [
                {
                  "op": "source",
                  "of": "session"
                },
                {
                  "op": "userTexts",
                  "re": "^/allow\\b",
                  "i": true
                }
              ]
            },
            "relate": [
              {
                "id": "has-evidence",
                "relation": {
                  "op": "nonEmpty",
                  "of": "found"
                },
                "message": "no matching evidence on record"
              }
            ]
          }
        },
        {
          "id": "step-userTexts-miss",
          "declare": {
            "mechanism": "stated-ground",
            "sources": {
              "session": {
                "transcript": true
              }
            },
            "scope": {
              "source": "target.path",
              "include": ["^broken/"]
            },
            "extract": {
              "found": [
                {
                  "op": "source",
                  "of": "session"
                },
                {
                  "op": "userTexts",
                  "re": "^/allow\\b"
                }
              ]
            },
            "relate": [
              {
                "id": "has-evidence",
                "relation": {
                  "op": "nonEmpty",
                  "of": "found"
                },
                "message": "no matching evidence on record"
              }
            ]
          }
        }
      ]
    },
    ".polydeukes/baseline.json": {
      "entries": {}
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "held/x.txt",
          "post": "x"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "broken/y.txt",
          "post": "y"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "session": {
      "userMessages": [
        {
          "text": "/ALLOW deploy"
        }
      ],
      "toolCalls": []
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-userTexts-miss' broken on broken/y.txt: no matching evidence on record",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-userTexts", "held/x.txt"],
      [
        "advised",
        "step-userTexts-miss",
        "broken/y.txt",
        "[{\"id\":\"has-evidence\",\"witnesses\":[{\"key\":\"found\",\"value\":null}],\"total\":1}]"
      ]
    ]
  }
}
