{
  "description": "A path matched by the scope exclude list is not judged by the discipline, so only the runner pass row remains.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "no-todo",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"],
              "exclude": ["/gen/"]
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "matches",
                  "re": "TODO"
                }
              ]
            },
            "relate": [
              {
                "id": "no-todo-added",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "adds a TODO marker"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "edit-tool",
        "args": {
          "file_path": "lib/gen/a.txt"
        },
        "fileChange": {
          "kind": "create",
          "path": "lib/gen/a.txt",
          "post": "// TODO"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "rows": [["passed", "covenant-check", "lib/gen/a.txt"]]
  }
}
