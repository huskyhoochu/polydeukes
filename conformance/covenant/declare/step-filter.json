{
  "description": "The filter step keeps the items every predicate admits and leaves their keys unchanged.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "step-filter",
          "declare": {
            "mechanism": "added-only",
            "extract": {
              "out": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "json"
                },
                {
                  "op": "items"
                },
                {
                  "op": "filter",
                  "when": [
                    {
                      "field": "status",
                      "eq": "open"
                    }
                  ]
                }
              ]
            },
            "relate": [
              {
                "id": "found",
                "relation": {
                  "op": "empty",
                  "of": "out"
                },
                "message": "found '{key}'"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/held.txt",
          "post": "[{\"status\":\"closed\"}]"
        }
      },
      {
        "name": "Write",
        "fileChange": {
          "kind": "create",
          "path": "src/broken.txt",
          "post": "[{\"status\":\"closed\"},{\"status\":\"open\"}]"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 0,
    "stderr": [
      "discipline 'step-filter' broken on src/broken.txt: found '1'",
      "covenant advisory: 1 verdict(s) recorded as advised, commit allowed"
    ],
    "rows": [
      ["passed", "step-filter", "src/held.txt"],
      [
        "advised",
        "step-filter",
        "src/broken.txt",
        "[{\"id\":\"found\",\"witnesses\":[{\"key\":\"1\",\"value\":{\"status\":\"open\"}}],\"total\":1}]"
      ]
    ]
  }
}
