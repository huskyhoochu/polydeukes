{
  "description": "On the session surface an in-scope call that would satisfy a changes reader over its one-file change set still records only skipped no-observation, with no passed row for the entry.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "needs-the-whole-change-set",
          "declare": {
            "mechanism": "companion",
            "scope": {
              "source": "target.path",
              "include": ["^lib/.*\\.ts$"]
            },
            "extract": {
              "own": [
                {
                  "op": "source",
                  "of": "target.path"
                }
              ],
              "changed": [
                {
                  "op": "source",
                  "of": "changes"
                },
                {
                  "op": "items"
                }
              ]
            },
            "relate": [
              {
                "id": "has-companion",
                "relation": {
                  "op": "implies",
                  "of": "own",
                  "requires": "changed"
                },
                "message": "{value}"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "edit-tool",
        "args": {
          "file_path": "lib/a.ts"
        },
        "fileChange": {
          "kind": "create",
          "path": "lib/a.ts",
          "post": "export const a = 1;\n"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": ["edit-tool"],
      "shell": [],
      "commandArgs": []
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "rows": [["skipped", "needs-the-whole-change-set", "lib/a.ts", "no-observation"]]
  }
}
