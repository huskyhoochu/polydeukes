{
  "description": "A write named by its absolute path under the protected directory is blocked.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["dist"]
    }
  },
  "stdin": "{\"toolCalls\": [{\"name\": \"session-write\", \"args\": {\"file_path\": \"@@ROOT@@/dist/x.js\", \"content\": \"x\\n\"}, \"fileChange\": {\"kind\": \"create\", \"path\": \"@@ROOT@@/dist/x.js\", \"post\": \"x\\n\"}}], \"subagentSpawns\": [], \"userMessages\": [], \"tools\": {\"mutating\": [\"session-write\"], \"shell\": [], \"commandArgs\": []}}",
  "expect": {
    "exit": 2,
    "stderr": ["session-write would modify protected path @@ROOT@@/dist/x.js"],
    "rows": [["blocked", "self-mod", "dist"]]
  }
}
