{
  "description": "An unclosed quote whose open span mentions the protected path is blocked.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["dist"]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Bash",
        "args": {
          "command": "echo \"dist/x"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": [],
      "shell": ["Bash"],
      "commandArgs": ["command"]
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["untokenizable command line mentions protected path dist"],
    "rows": [
      ["blocked", "shell-mod", "dist"],
      ["skipped", "shell-unjudgeable", "-", "no-observation"]
    ]
  }
}
