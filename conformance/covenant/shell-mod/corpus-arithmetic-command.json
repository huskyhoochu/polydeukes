{
  "description": "A command after an arithmetic command is still judged and blocks.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["sub/protected/dist"]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Bash",
        "args": {
          "command": "((i++)) && rm -rf sub/protected/dist"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": [],
      "shell": ["Bash"],
      "commandArgs": ["command"]
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["rm mentions protected path sub/protected/dist without read-only proof"],
    "rows": [
      ["blocked", "shell-mod", "sub/protected/dist"],
      ["skipped", "shell-unjudgeable", "-", "no-observation"]
    ]
  }
}
