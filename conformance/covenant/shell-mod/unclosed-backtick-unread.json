{
  "description": "A cat whose line ends in an unpaired backtick is recorded as an unread span, so it breaks and leaves a skipped shell-unjudgeable row.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["dist"]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Bash",
        "args": {
          "command": "cat dist/a `"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": [],
      "shell": ["Bash"],
      "commandArgs": ["command"]
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["protected path dist"],
    "rows": [
      ["blocked", "shell-mod", "dist"],
      ["skipped", "shell-unjudgeable", "-", "no-observation"]
    ]
  }
}
