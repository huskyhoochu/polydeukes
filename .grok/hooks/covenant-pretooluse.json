{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write|search_replace|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/funes/Documents/personal/polydeukes/.polydeukes/bin/pdks' 'adapter' 'grok' 'hook' '--project-root' '/Users/funes/Documents/personal/polydeukes' || exit 2",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
