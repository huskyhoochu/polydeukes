{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!.claude/workflows", "!**/*.astro", "!CHANGELOG.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "proseWrap": "always"
    }
  },
  "plugins": [
    {
      "path": "./biome-plugins/barrels-only-reexport.grit",
      "includes": ["packages/*/src/index.ts", "packages/polydeukes/src/claude-code.ts"]
    },
    {
      "path": "./biome-plugins/production-ignores-the-test-runner.grit",
      "includes": ["packages/*/src/**"]
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noSkippedTests": "error"
      },
      "nursery": {
        "useConsistentHeadingLevel": "on",
        "useFencedCodeLanguage": "on",
        "useSingleTopLevelHeading": "on",
        "useTopLevelHeading": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/src/index", "**/src/index.ts", "**/src/index.js"],
                    "message": "A package test imports ../src/<module>.ts, never its own barrel."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
