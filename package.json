{
  "name": "polydeukes-monorepo",
  "version": "0.20.1",
  "author": "huskyhoochu <dfg1499@gmail.com>",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run build && pnpm -r --parallel test",
    "test:watch": "pnpm -r --parallel exec vitest --exclude \"**/*.e2e.test.ts\"",
    "dev": "turbo run dev",
    "check": "biome check --write .",
    "format": "biome format --write --files-ignore-unknown=true .",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@polydeukes/adapter-claude-code": "workspace:*",
    "@polydeukes/adapter-codex": "workspace:*",
    "@polydeukes/adapter-grok": "workspace:*",
    "@polydeukes/sdk-ts": "workspace:*",
    "lefthook": "^2.2.2",
    "polydeukes": "workspace:*",
    "turbo": "latest"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  }
}
