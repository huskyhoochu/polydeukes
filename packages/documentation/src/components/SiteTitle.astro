---
import Logo from './Logo.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <Logo size={28} decorative />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: 1.3rem;
    font-family: var(--font-text), ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    letter-spacing: normal;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
</style>
