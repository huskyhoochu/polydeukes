{
  "name": "@polydeukes/sdk-ts",
  "version": "0.20.1",
  "description": "Polydeukes SDK for TypeScript — runs four covenant and memory verbs through a standalone pdks executable and returns results as values. Beta.",
  "author": "huskyhoochu <dfg1499@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huskyhoochu/polydeukes.git",
    "directory": "packages/sdk-ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate-types": "node scripts/generate-types.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@polydeukes/core": "workspace:^",
    "@types/node": "catalog:",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
