{
  "description": "A shell call whose commandArgs name is absent from args routes to the placeholder subject and blocks as unjudgeable.",
  "args": ["--enforce", "block"],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["dist"]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "Bash",
        "cwd": "@@ROOT@@",
        "args": {
          "command": "rm dist/a"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": [],
      "shell": ["Bash"],
      "commandArgs": ["cmd"]
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["unjudgeable shell call Bash"],
    "rows": [["blocked", "shell-mod", "-"]]
  }
}
