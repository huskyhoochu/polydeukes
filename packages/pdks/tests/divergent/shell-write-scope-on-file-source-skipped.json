{
  "description": "A discipline whose scope reads a file source records a skipped row for a shell write at any path.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"],
      "disciplines": [
        {
          "id": "gated-todo",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "cfg",
              "include": ["on"]
            },
            "sources": {
              "cfg": {
                "file": "cfg.txt"
              }
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "matches",
                  "re": "TODO"
                }
              ]
            },
            "relate": [
              {
                "id": "clean",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "adds a TODO marker"
              }
            ]
          }
        }
      ]
    },
    ".polydeukes/baseline.json": {
      "entries": {}
    },
    "cfg.txt": "on"
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "shell-tool",
        "args": {
          "command": "echo x > out/b.txt"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": ["edit-tool"],
      "shell": ["shell-tool"],
      "commandArgs": ["command"]
    },
    "session": {
      "userMessages": [],
      "toolCalls": []
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "rows": [["skipped", "gated-todo", "out/b.txt", "no-observation"]]
  }
}
