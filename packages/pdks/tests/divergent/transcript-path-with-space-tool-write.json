      "shell": ["shell-tool"],
      "commandArgs": ["command"]
    },
    "session": {
      "userMessages": [],
      "toolCalls": [],
      "evidencePath": "@@HOME@@/a b/s.jsonl"
    }
  },
  "expect": {
    "exit": 2,
    "stderr": ["session transcript"],
    "rows": [["blocked", "transcript-mod", "@@HOME@@/a b/s.jsonl"]]
  }
