{
  "description": "A shell write inside a discipline scope records one skipped row naming the written path, and the written content is not judged.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "protectedPaths": ["gate"],
      "disciplines": [
        {
          "id": "no-todo",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"]
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "matches",
                  "re": "TODO"
                }
              ]
            },
            "relate": [
              {
                "id": "clean",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "adds a TODO marker"
              }
            ]
          }
        }
      ]
    },
    ".polydeukes/baseline.json": {
      "entries": {}
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "shell-tool",
        "args": {
          "command": "echo TODO > lib/a.txt"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": [],
    "tools": {
      "mutating": ["edit-tool"],
      "shell": ["shell-tool"],
      "commandArgs": ["command"]
    },
    "session": {
      "userMessages": [],
      "toolCalls": []
    }
  },
  "expect": {
    "exit": 0,
    "stderr": [],
    "rows": [["skipped", "no-todo", "lib/a.txt", "no-observation"]]
  }
}
