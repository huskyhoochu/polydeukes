{
  "description": "A modify change whose pre is null leaves the pre source absent instead of reading the text null, so the discipline cannot judge.",
  "args": [],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "reads-pre",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"]
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "pre"
                },
                {
                  "op": "matches",
                  "re": "TODO"
                }
              ]
            },
            "relate": [
              {
                "id": "clean",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "has TODO"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": {
    "toolCalls": [
      {
        "name": "edit-tool",
        "args": {
          "file_path": "lib/a.txt"
        },
        "fileChange": {
          "kind": "modify",
          "path": "lib/a.txt",
          "pre": null,
          "post": "x"
        }
      }
    ],
    "subagentSpawns": [],
    "userMessages": []
  },
  "expect": {
    "exit": 2,
    "stderr": ["discipline 'reads-pre' cannot judge lib/a.txt: pre — "],
    "rows": [["blocked", "reads-pre", "lib/a.txt"]]
  }
}
