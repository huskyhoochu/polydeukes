{
  "description": "A hunk whose declared counts run past the end of input exits 3.",
  "args": ["--diff"],
  "tree": {
    "polydeukes.config.yaml": {
      "disciplines": [
        {
          "id": "reads-post",
          "declare": {
            "mechanism": "added-only",
            "scope": {
              "source": "target.path",
              "include": ["^lib/"]
            },
            "extract": {
              "hit": [
                {
                  "op": "source",
                  "of": "post"
                },
                {
                  "op": "matches",
                  "re": "."
                }
              ]
            },
            "relate": [
              {
                "id": "seen",
                "relation": {
                  "op": "empty",
                  "of": "hit"
                },
                "message": "{value}"
              }
            ]
          }
        }
      ]
    }
  },
  "stdin": "--- a/lib/a.txt\n+++ b/lib/a.txt\n@@ -1,2 +1,3 @@\n x\n+y\n",
  "expect": {
    "exit": 3,
    "stderr": ["covenant check failed closed: unified diff: hunk ends before its declared lines"],
    "rows": [["blocked", "covenant-check", "-"]]
  }
}
