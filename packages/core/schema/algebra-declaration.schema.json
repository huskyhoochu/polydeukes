{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huskyhoochu/polydeukes/schema/algebra-declaration.schema.json",
  "title": "Polydeukes algebra declaration",
  "description": "One algebra declaration: five blocks, a relation position closed to seven names, a binary combinator position closed to three, and an open unary extraction vocabulary. Reference resolution, relate-entry id uniqueness, and cycle detection are validator-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["discipline", "mechanism", "extract", "relate"],
  "properties": {
    "discipline": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "enum": [
        "pairing",
        "companion",
        "monotonic-order",
        "fingerprint-sync",
        "producer-owned",
        "self-absolution-ban",
        "actor-scope",
        "precedent",
        "phase-order",
        "turn-locality",
        "stated-ground",
        "controlled-vocabulary",
        "naming",
        "added-only",
        "one-way-marker",
        "scoped-valve"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "supply": {
      "$ref": "#/$defs/supply"
    },
    "extract": {
      "$ref": "#/$defs/extract"
    },
    "relate": {
      "$ref": "#/$defs/relate"
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relate"],
      "properties": {
        "extract": {
          "$ref": "#/$defs/extract"
        },
        "relate": {
          "$ref": "#/$defs/relate"
        }
      }
    }
  },
  "$defs": {
    "extractName": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "not": { "enum": ["changes", "state"] }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "regex"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "regex"
          }
        },
        "excludeIgnoreCase": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "description": "What each name outside the target stands for, under the name a declaration reads it by. The kind position is closed to 'file', 'sidecar' and 'transcript', exactly one per entry: a file path is repo-relative, so a leading '/' and a '..' segment are refused, and a sidecar channel's or a transcript's value is the marker true because its location is the host's fact.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "not": {
          "enum": ["target.path", "pre", "post", "state", "changes"]
        }
      },
      "additionalProperties": {
        "type": "object",
        "oneOf": [
          {
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))"
              }
            }
          },
          {
            "additionalProperties": false,
            "required": ["sidecar"],
            "properties": {
              "sidecar": {
                "const": true
              }
            }
          },
          {
            "additionalProperties": false,
            "required": ["transcript"],
            "properties": {
              "transcript": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "supply": {
      "type": "object",
      "properties": {
        "state": {
          "enum": ["error", "pass"]
        }
      },
      "additionalProperties": {
        "enum": ["error", "pass", "empty"]
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/pipeline"
      }
    },
    "pipeline": {
      "description": "A combinator stands only as the first step: prefixItems governs position 0, items governs the rest.",
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/step"
        }
      ],
      "items": {
        "$ref": "#/$defs/unaryStep"
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/combinatorStep"
        },
        {
          "$ref": "#/$defs/unaryStep"
        }
      ]
    },
    "combinatorStep": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": ["union", "onlyIn", "intersect"]
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["op", "of"],
          "properties": {
            "op": {
              "enum": ["union", "intersect"]
            },
            "of": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/extractName"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["op", "of", "notIn"],
          "properties": {
            "op": {
              "const": "onlyIn"
            },
            "of": {
              "$ref": "#/$defs/extractName"
            },
            "notIn": {
              "$ref": "#/$defs/extractName"
            }
          }
        }
      ]
    },
    "unaryStep": {
      "description": "Open vocabulary: any name outside the three combinators, arguments unconstrained — except that referencing two extractions (an array `of`, or a `notIn`) makes the step a combinator by shape.",
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": ["union", "onlyIn", "intersect"]
          }
        },
        "of": {
          "not": {
            "type": "array"
          }
        }
      },
      "not": {
        "required": ["notIn"]
      }
    },
    "relate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relateEntry"
      }
    },
    "relateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relation"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "$ref": "#/$defs/relation"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "messageBySide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {
              "type": "string",
              "minLength": 1
            },
            "right": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "oneOf": [
        {
          "description": "A plain message, on any relation.",
          "required": ["message"],
          "not": {
            "required": ["messageBySide"]
          }
        },
        {
          "description": "Side-keyed messages, only on Equal — the one relation with two sides.",
          "required": ["messageBySide"],
          "not": {
            "required": ["message"]
          },
          "properties": {
            "relation": {
              "properties": {
                "op": {
                  "const": "equal"
                }
              }
            }
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "enum": ["empty", "nonEmpty", "equal", "subset", "implies", "ordered", "unchanged"]
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["op", "of"],
          "properties": {
            "op": {
              "enum": ["empty", "nonEmpty", "unchanged"]
            },
            "of": {
              "$ref": "#/$defs/extractName"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["op", "of"],
          "properties": {
            "op": {
              "const": "equal"
            },
            "of": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/extractName"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["op", "of", "in"],
          "properties": {
            "op": {
              "const": "subset"
            },
            "of": {
              "$ref": "#/$defs/extractName"
            },
            "in": {
              "$ref": "#/$defs/extractName"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["op", "of", "requires"],
          "properties": {
            "op": {
              "const": "implies"
            },
            "of": {
              "$ref": "#/$defs/extractName"
            },
            "requires": {
              "$ref": "#/$defs/extractName"
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["op", "of"],
          "properties": {
            "op": {
              "const": "ordered"
            },
            "of": {
              "$ref": "#/$defs/extractName"
            },
            "strict": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
