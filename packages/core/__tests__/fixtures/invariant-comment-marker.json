{
  "discipline": "invariant-comment-marker",
  "mechanism": "one-way-marker",
  "scope": {
    "source": "target.path",
    "include": [".*"],
    "exclude": ["\\.(md|mdx|markdown|txt)$"],
    "excludeIgnoreCase": true
  },
  "supply": {
    "pre": "error",
    "post": "error"
  },
  "extract": {
    "preInvariants": [
      {
        "op": "source",
        "of": "pre"
      },
      {
        "op": "lines"
      },
      {
        "op": "matches",
        "re": "(?://|#|--|\\*)\\s*INVARIANT\\("
      }
    ],
    "postInvariants": [
      {
        "op": "source",
        "of": "post"
      },
      {
        "op": "lines"
      },
      {
        "op": "matches",
        "re": "(?://|#|--|\\*)\\s*INVARIANT\\("
      }
    ]
  },
  "relate": [
    {
      "id": "invariant-preserved",
      "relation": {
        "op": "subset",
        "of": "preInvariants",
        "in": "postInvariants"
      },
      "message": "{value}"
    }
  ]
}
