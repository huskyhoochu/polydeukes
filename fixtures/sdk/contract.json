    },
    {
      "id": "additional-fields",
      "verb": "memory_search",
      "args": ["memory", "search", "needleword", "--json"],
      "status": 0,
      "stdout": "{\"ingestedAt\": \"fixture-time\", \"results\": [{\"id\": \"notes/alpha#topic\", \"conceptId\": \"notes/alpha\", \"docTitle\": \"Alpha\", \"sectionTitle\": \"Topic\", \"status\": \"stable\", \"trust\": \"unverified\", \"stale\": false, \"matchPath\": \"and\", \"supersededBy\": [], \"futureField\": \"future\"}], \"futureRoot\": true}",
      "stderr": "",
      "result": "Found"
    }
  ]
}
