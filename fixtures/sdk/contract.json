      "status": 0,
      "stdout": "{\"ingestedAt\": \"fixture-time\", \"results\": [{\"id\": \"notes/alpha#topic\", \"conceptId\": \"notes/alpha\", \"docTitle\": \"Alpha\", \"sectionTitle\": \"Topic\", \"status\": \"stable\", \"trust\": \"unverified\", \"stale\": false, \"matchPath\": \"and\", \"supersededBy\": []}]}",
      "stderr": "",
